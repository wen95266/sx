# ==============================================================================
# 🀄 十三水 (Chinese Poker) 环境变量配置文件示例 (.env.example)
# 复制此文件为 .env 并填入您的真实 Token 与管理员 ID
# ==============================================================================

# 1. Telegram 运维机器人配置
# 从 Telegram 官方 @BotFather 申请获得的 Bot Token
TG_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRstuVWXyz"

# 管理员 Telegram 数字 User ID (在 Telegram 中向 @userinfobot 发送任意消息即可获取一串数字)
TG_ADMIN_ID="123456789"

# 2. 游戏服务监听端口 (例如 8080 或 3000)
PORT=8080

# 3. AI Studio 默认注入项 (可选)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
