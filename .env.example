# ==============================================================================
# 🀄 十三水 (Chinese Poker) 环境变量配置文件示例 (.env.example)
# 复制此文件为 .env 并填入您的真实 Token 与管理员 ID
# ==============================================================================

# 1. Telegram 运维机器人配置
# 从 Telegram 官方 @BotFather 申请获得的 Bot Token
TG_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRstuVWXyz"

# 管理员 Telegram 数字 User ID (在 Telegram 中向 @userinfobot 发送任意消息即可获取一串数字)
TG_ADMIN_ID="123456789"

# Webhook 模式配置 (推荐！部署在公网、Serv00 或配置了 HTTPS 域名时使用)
# 例如: TG_WEBHOOK_URL="https://poker.yourdomain.com/api/telegram/webhook"
# 设置后启动 node server.js 会自动向 Telegram 注册 Webhook，无需保持后台轮询进程
# TG_WEBHOOK_URL="https://poker.yourdomain.com/api/telegram/webhook"
# TG_WEBHOOK_SECRET="自定义安全密钥(可选)"

# 国内网络 / Termux 代理配置 (如果直连 api.telegram.org 超时，可填反向代理地址或本地代理)
# TG_API_BASE="https://api.telegram.org"
# HTTPS_PROXY="http://127.0.0.1:7890"

# 2. 游戏服务监听端口 (例如 8080 或 3000)
PORT=8080

# 3. AI Studio 默认注入项 (可选)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
