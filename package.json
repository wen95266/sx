{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:8080": "vite --port=8080 --host=0.0.0.0",
    "build": "vite build",
    "build:lowmem": "NODE_OPTIONS='--max-old-space-size=384' vite build",
    "start": "node server.js",
    "start:8080": "PORT=8080 node server.js",
    "start:lowmem": "node --max-old-space-size=256 server.js",
    "preview": "vite preview",
    "serve:8080": "vite preview --port=8080 --host=0.0.0.0",
    "bot": "node scripts/tgBot.js",
    "bot:check": "node scripts/tgBot.js --check",
    "bot:webhook": "node scripts/tgBot.js --set-webhook",
    "bot:del-webhook": "node scripts/tgBot.js --del-webhook",
    "bot:info": "node scripts/tgBot.js --info",
    "bot:polling": "node scripts/tgBot.js --del-webhook && node scripts/tgBot.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "cap:build": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
